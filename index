<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>익명 대나무숲 | 거절 실패기 워크샵</title>

  <!-- Google Fonts: Noto Sans KR & Pretendard CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- QRCode.js CDN (클라이언트 측 실제 스캔 가능한 QR 생성) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <!-- Tailwind Custom Theme Configuration -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Pretendard', '"Noto Sans KR"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
          },
          colors: {
            cream: {
              50: '#FDFCF9',
              100: '#F7F5EE',
              200: '#EFECE1',
              300: '#E3DEC9',
            },
            sage: {
              50: '#F2F7F3',
              100: '#E2EDE4',
              200: '#C5DBC9',
              300: '#9DC2A5',
              400: '#72A37D',
              500: '#4F7F5B',
              600: '#3D6648',
              700: '#2F5038',
              800: '#233B2A',
              900: '#182A1D',
            },
            warm: {
              50: '#FDF7F1',
              100: '#F9EBDD',
              200: '#F1D4B7',
              400: '#E09F67',
              500: '#D18345',
              600: '#B56930',
            }
          },
          boxShadow: {
            'soft': '0 8px 30px rgba(35, 59, 42, 0.06)',
            'card': '0 4px 20px rgba(35, 59, 42, 0.045)',
            'glow': '0 10px 35px rgba(79, 127, 91, 0.16)',
            'spotlight': '0 14px 40px rgba(209, 131, 69, 0.14)',
          },
          keyframes: {
            fadeUp: {
              '0%': { opacity: '0', transform: 'translateY(12px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            gentleFloat: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-6px)' },
            },
            pop: {
              '0%': { transform: 'scale(1)' },
              '45%': { transform: 'scale(1.22)' },
              '100%': { transform: 'scale(1)' },
            },
            pulseRing: {
              '0%': { transform: 'scale(0.95)', opacity: '0.8' },
              '70%': { transform: 'scale(1.35)', opacity: '0' },
              '100%': { transform: 'scale(1.35)', opacity: '0' },
            }
          },
          animation: {
            'fade-up': 'fadeUp 0.45s ease-out forwards',
            'gentle-float': 'gentleFloat 5s ease-in-out infinite',
            'pop': 'pop 0.3s ease-out',
            'pulse-ring': 'pulseRing 1.8s cubic-bezier(0.24, 0, 0.38, 1) infinite',
          }
        }
      }
    };
  </script>
</head>

<body class="bg-cream-100 text-sage-900 font-sans antialiased min-h-screen overflow-x-hidden selection:bg-sage-200 selection:text-sage-900">

  <!-- 배경 은은한 자연광 블롭 데코레이션 -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-sage-200/40 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-24 w-80 h-80 bg-warm-200/35 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 left-1/3 w-96 h-96 bg-sage-100/60 rounded-full blur-3xl"></div>
  </div>

  <!-- ===================================================================== -->
  <!-- 상단 네비게이션 바 (모바일 작성 전용 ?mode=write 모드에서는 자동 숨김) -->
  <!-- ===================================================================== -->
  <header id="main-navbar" class="sticky top-0 z-30 bg-cream-50/85 backdrop-blur-md border-b border-sage-200/70 transition-all">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-col sm:flex-row items-center justify-between gap-3">
      <!-- 브랜드 로고 -->
      <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start">
        <div class="flex items-center gap-2.5">
          <div class="w-10 h-10 rounded-2xl bg-sage-500 text-white flex items-center justify-center shadow-sm">
            <!-- 대나무 잎 SVG 아이콘 -->
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21V3" />
              <path d="M12 14c3-1 5-3.5 5-6.5-3 0-5 2-5 5" />
              <path d="M12 10C9 9 7 6.5 7 3.5c3 0 5 2 5 5" />
              <path d="M9 17h6" />
            </svg>
          </div>
          <div>
            <h1 class="text-base sm:text-lg font-bold text-sage-900 tracking-tight leading-tight">익명 대나무숲</h1>
            <p class="text-xs text-sage-600">회사 워크샵 · 거절 실패기 나눔</p>
          </div>
        </div>

        <!-- 모바일에서 간단한 연결 상태 배지 -->
        <div class="flex sm:hidden items-center gap-1.5 px-2.5 py-1 rounded-full bg-sage-50 border border-sage-200 text-xs font-medium text-sage-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="sync-status-short">LIVE</span>
        </div>
      </div>

      <!-- 페이지 전환 탭 -->
      <nav class="flex items-center bg-cream-200/80 p-1 rounded-2xl border border-sage-200/60 w-full sm:w-auto" role="tablist" aria-label="페이지 전환">
        <button id="tab-write" type="button" role="tab" aria-selected="true"
          class="flex-1 sm:flex-initial px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 bg-white text-sage-800 shadow-sm">
          <span>🎋</span>
          <span>1. QR 안내 &amp; 사연 작성</span>
        </button>
        <button id="tab-dashboard" type="button" role="tab" aria-selected="false"
          class="flex-1 sm:flex-initial px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 text-sage-600 hover:text-sage-900">
          <span>📋</span>
          <span>2. 실시간 대시보드</span>
          <span id="nav-count-badge" class="ml-0.5 px-2 py-0.5 text-xs rounded-full bg-sage-100 text-sage-700 font-bold">0</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- 메인 콘텐츠 컨테이너 -->
  <!-- ===================================================================== -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

    <!-- =================================================================== -->
    <!-- 1페이지: QR 코드 안내 및 '거절 실패기' 작성 페이지 -->
    <!-- =================================================================== -->
    <section id="page-write" class="space-y-8 animate-fade-up">

      <!-- 모바일 전용 작성 모드(?mode=write) 상단 미니 헤더 -->
      <div id="mobile-only-header" class="hidden text-center pt-2 pb-1 space-y-2">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-3xl bg-sage-500 text-white shadow-glow mx-auto animate-gentle-float">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21V3" />
            <path d="M12 14c3-1 5-3.5 5-6.5-3 0-5 2-5 5" />
            <path d="M12 10C9 9 7 6.5 7 3.5c3 0 5 2 5 5" />
            <path d="M9 17h6" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold text-sage-900 tracking-tight">익명 대나무숲</h2>
        <p class="text-sm text-sage-600">우리 팀의 솔직하고 따뜻한 '거절 실패기'</p>
      </div>

      <!-- 2컬럼 그리드 (진행자 모드: 좌측 QR + 우측 작성 폼 / 참가자 모드: 중앙 정렬 작성 폼) -->
      <div id="write-layout-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">

        <!-- [좌측 5칸] 진행자/공유용 QR 코드 생성 영역 -->
        <div id="qr-section" class="lg:col-span-5 bg-white/95 rounded-3xl border border-sage-200/80 shadow-soft p-6 sm:p-7 space-y-6">
          <div class="flex items-start justify-between gap-3">
            <div>
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sage-50 border border-sage-200 text-sage-700 text-xs font-semibold mb-2">
                <span>📱</span> 참가자 접속 안내
              </span>
              <h2 class="text-xl font-bold text-sage-900">QR 코드로 바로 참여하기</h2>
              <p class="text-sm text-sage-600 mt-1 leading-relaxed">
                참가자들이 휴대폰 카메라로 스캔하면 모바일 전용 '거절 실패기' 작성 화면으로 바로 이동합니다.
              </p>
            </div>
          </div>

          <!-- QR 코드 디스플레이 박스 -->
          <div class="bg-cream-50 rounded-2xl border border-sage-200/70 p-6 flex flex-col items-center justify-center text-center space-y-4">
            <div class="p-4 bg-white rounded-2xl shadow-card border border-sage-100">
              <div id="qrcode-container" class="w-[184px] h-[184px] flex items-center justify-center"></div>
            </div>
            <p class="text-xs text-sage-600 font-medium break-all max-w-full px-2" id="qr-url-preview"></p>

            <!-- 로컬 환경 안내 배너 (file:// 또는 iframe 미리보기 시 표시) -->
            <div id="local-url-notice" class="hidden w-full text-left bg-warm-50 border border-warm-200 rounded-xl p-3 text-xs text-warm-600 leading-relaxed">
              💡 현재 로컬/미리보기 주소입니다. 실제 워크샵에서는 이 HTML 파일을 웹(GitHub Pages, 사내 서버 등)에 올린 뒤, 아래 입력창에 배포된 주소를 넣어 QR을 갱신해 주세요.
            </div>

            <!-- 주요 QR 액션 버튼 -->
            <div class="grid grid-cols-2 gap-2.5 w-full pt-1">
              <button id="btn-open-qr-modal" type="button"
                class="py-3 px-4 rounded-xl bg-sage-600 hover:bg-sage-700 active:scale-[0.98] text-white text-sm font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
                <span>QR 크게 보기</span>
              </button>
              <button id="btn-copy-link" type="button"
                class="py-3 px-4 rounded-xl bg-white hover:bg-sage-50 active:scale-[0.98] text-sage-800 border border-sage-200 text-sm font-semibold transition-all flex items-center justify-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>링크 복사</span>
              </button>
            </div>
          </div>

          <!-- 진행자용 링크 직접 수정 영역 -->
          <div class="space-y-2 pt-1">
            <label for="qr-url-input" class="block text-xs font-semibold text-sage-700">
              QR 연결 링크 직접 수정 (호스팅 주소 입력 가능)
            </label>
            <div class="flex gap-2">
              <input id="qr-url-input" type="url"
                placeholder="https://your-workshop-url.com/?mode=write"
                class="flex-1 min-w-0 px-3.5 py-2.5 rounded-xl bg-cream-50 border border-sage-200 text-xs sm:text-sm text-sage-900 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:bg-white transition-all" />
              <button id="btn-update-qr" type="button"
                class="px-4 py-2.5 rounded-xl bg-sage-100 hover:bg-sage-200 text-sage-800 text-xs sm:text-sm font-semibold transition-colors whitespace-nowrap">
                QR 갱신
              </button>
            </div>
          </div>

          <!-- 참가자 모바일 화면 미리보기 버튼 -->
          <div class="pt-2 border-t border-sage-100 flex items-center justify-between text-xs text-sage-600">
            <span>참가자 화면이 어떻게 보일지 궁금하신가요?</span>
            <button id="btn-preview-mobile" type="button" class="text-sage-700 font-semibold underline underline-offset-4 hover:text-sage-900">
              참가자 모드 보기 →
            </button>
          </div>
        </div>

        <!-- [우측 7칸] '거절 실패기' 경험담 작성 폼 -->
        <div id="write-form-wrapper" class="lg:col-span-7 bg-white/95 rounded-3xl border border-sage-200/80 shadow-soft p-6 sm:p-8 relative overflow-hidden">
          <!-- 상단 따뜻한 심리적 안정감 배너 -->
          <div class="bg-gradient-to-br from-sage-50 to-cream-50 rounded-2xl border border-sage-200/70 p-4 sm:p-5 mb-6">
            <div class="flex items-start gap-3">
              <span class="text-2xl leading-none mt-0.5 select-none">🌿</span>
              <div class="space-y-1.5">
                <p class="text-sm sm:text-base font-bold text-sage-900 leading-snug">
                  완벽하게 거절하지 못해도 괜찮아요.
                </p>
                <p class="text-xs sm:text-sm text-sage-700 leading-relaxed">
                  작성하신 경험담은 <strong>100% 익명</strong>으로 안전하게 공유됩니다. 거절하려다 망설였던 순간, 어쩔 수 없이 '네'라고 했던 기억을 편안하게 들려주세요.
                </p>
                <div class="flex flex-wrap gap-2 pt-1">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white/90 border border-sage-200/80 text-[11px] font-medium text-sage-700">🔒 100% 익명 보장</span>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white/90 border border-sage-200/80 text-[11px] font-medium text-sage-700">🤝 판단 없는 공감</span>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white/90 border border-sage-200/80 text-[11px] font-medium text-sage-700">🌱 심리적 안전공간</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 작성 폼 본문 -->
          <form id="story-form" class="space-y-5" novalidate>
            <!-- 항목 1: 닉네임 -->
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <label for="input-nickname" class="text-sm font-bold text-sage-900">
                  닉네임 <span class="text-warm-500">*</span>
                </label>
                <button id="btn-random-nickname" type="button"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-sage-50 hover:bg-sage-100 active:scale-95 border border-sage-200 text-xs font-semibold text-sage-700 transition-all">
                  <span>🎲</span>
                  <span>랜덤 닉네임</span>
                </button>
              </div>
              <input id="input-nickname" name="nickname" type="text" maxlength="24" required
                placeholder="예: 거절못하는 판다, 마음약한 수달"
                class="w-full px-4 py-3.5 rounded-2xl bg-cream-50 border border-sage-200 text-sm sm:text-base text-sage-900 placeholder:text-sage-400 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:bg-white transition-all" />
            </div>

            <!-- 항목 2: 제목 (또는 키워드) -->
            <div class="space-y-2">
              <label for="input-title" class="block text-sm font-bold text-sage-900">
                제목 (또는 키워드) <span class="text-warm-500">*</span>
              </label>
              <input id="input-title" name="title" type="text" maxlength="60" required
                placeholder="예: 퇴근 5분 전 급한 부탁, #야근 #착한아이증후군"
                class="w-full px-4 py-3.5 rounded-2xl bg-cream-50 border border-sage-200 text-sm sm:text-base text-sage-900 placeholder:text-sage-400 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:bg-white transition-all" />
            </div>

            <!-- 항목 3: 내용 -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label for="input-content" class="block text-sm font-bold text-sage-900">
                  내용 <span class="text-warm-500">*</span>
                </label>
                <span id="char-count" class="text-xs text-sage-500 tabular-nums">0 / 600자</span>
              </div>
              <textarea id="input-content" name="content" rows="5" maxlength="600" required
                placeholder="어떤 상황에서 거절하기 어려웠나요? 그때의 기분이나 돌아보니 드는 생각을 편하게 적어주세요."
                class="w-full px-4 py-3.5 rounded-2xl bg-cream-50 border border-sage-200 text-sm sm:text-base text-sage-900 placeholder:text-sage-400 focus:outline-none focus:ring-2 focus:ring-sage-400 focus:bg-white transition-all resize-y leading-relaxed"></textarea>
            </div>

            <!-- 인라인 유효성 오류 메시지 -->
            <p id="form-error-msg" class="hidden text-xs sm:text-sm font-medium text-rose-600 bg-rose-50 border border-rose-200 rounded-xl px-4 py-2.5"></p>

            <!-- 제출 버튼 -->
            <button id="btn-submit-story" type="submit"
              class="w-full py-4 px-6 rounded-2xl bg-sage-600 hover:bg-sage-700 active:scale-[0.99] text-white font-bold text-base shadow-glow transition-all flex items-center justify-center gap-2">
              <span>🎋</span>
              <span>대나무숲에 사연 남기기</span>
            </button>
          </form>

          <!-- 제출 완료 화면 (제출 성공 시 폼 대신 표시) -->
          <div id="submit-success-view" class="hidden py-8 text-center space-y-6 animate-fade-up">
            <div class="w-20 h-20 rounded-full bg-sage-100 text-4xl flex items-center justify-center mx-auto shadow-inner">
              🎋
            </div>
            <div class="space-y-2">
              <h3 class="text-xl sm:text-2xl font-bold text-sage-900">
                대나무숲에 안전하게 전달되었습니다 🎋
              </h3>
              <p class="text-sm sm:text-base text-sage-600 leading-relaxed max-w-md mx-auto">
                용기 내어 솔직한 이야기를 나누어 주셔서 감사합니다.<br />
                여러분의 이야기가 오늘 워크샵에 따뜻한 공감을 더해줄 거예요.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2 max-w-md mx-auto">
              <button id="btn-write-another" type="button"
                class="flex-1 py-3.5 px-5 rounded-2xl bg-sage-600 hover:bg-sage-700 text-white font-semibold text-sm shadow-sm transition-all">
                ✍️ 하나 더 작성하기
              </button>
              <button id="btn-go-dashboard-after-submit" type="button"
                class="flex-1 py-3.5 px-5 rounded-2xl bg-cream-100 hover:bg-cream-200 text-sage-800 border border-sage-200 font-semibold text-sm transition-all">
                📋 실시간 대시보드 보기
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 모바일 작성 전용 모드 하단 작은 링크 -->
      <div id="mobile-footer-link" class="hidden text-center pt-2 pb-6">
        <button id="btn-exit-mobile-mode" type="button"
          class="text-xs text-sage-500 hover:text-sage-800 underline underline-offset-4 transition-colors">
          실시간 대시보드 및 진행자 화면 보기 →
        </button>
      </div>
    </section>

    <!-- =================================================================== -->
