    function checkInitialRoute() {
      const params = new URLSearchParams(window.location.search);
      const modeParam = params.get('mode');
      const hash = window.location.hash.replace('#', '').toLowerCase();

      if (modeParam === 'write' || hash === 'write') {
        setMobileWriteOnlyMode(true);
        switchPage('write');
      } else if (modeParam === 'dashboard' || hash === 'dashboard') {
        setMobileWriteOnlyMode(false);
        switchPage('dashboard');
      } else {
        setMobileWriteOnlyMode(false);
        switchPage('write');
      }
    }

    function setMobileWriteOnlyMode(enabled) {
      state.isMobileWriteOnly = enabled;

      if (enabled) {
        els.navbar.classList.add('hidden');
        els.qrSection.classList.add('hidden');
        els.mobileOnlyHeader.classList.remove('hidden');
        els.mobileFooterLink.classList.remove('hidden');
        els.writeLayoutGrid.className = 'max-w-xl mx-auto';
        els.writeFormWrapper.classList.remove('lg:col-span-7');
      } else {
        els.navbar.classList.remove('hidden');
        els.qrSection.classList.remove('hidden');
        els.mobileOnlyHeader.classList.add('hidden');
        els.mobileFooterLink.classList.add('hidden');
        els.writeLayoutGrid.className = 'grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start';
        els.writeFormWrapper.classList.add('lg:col-span-7');
      }
    }

    function switchPage(page) {
      state.currentPage = page;

      if (page === 'write') {
        els.pageWrite.classList.remove('hidden');
        els.pageDashboard.classList.add('hidden');

        els.tabWrite.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 bg-white text-sage-800 shadow-sm';
        els.tabWrite.setAttribute('aria-selected', 'true');
        els.tabDashboard.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 text-sage-600 hover:text-sage-900';
        els.tabDashboard.setAttribute('aria-selected', 'false');
      } else {
        // 대시보드로 이동할 때는 상단 메뉴 복원
        if (state.isMobileWriteOnly) {
          setMobileWriteOnlyMode(false);
        }
        els.pageWrite.classList.add('hidden');
        els.pageDashboard.classList.remove('hidden');

        els.tabDashboard.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 bg-white text-sage-800 shadow-sm';
        els.tabDashboard.setAttribute('aria-selected', 'true');
        els.tabWrite.className = 'flex-1 sm:flex-initial px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-2 text-sage-600 hover:text-sage-900';
        els.tabWrite.setAttribute('aria-selected', 'false');
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* =======================================================================
       8. 발언 타이머 로직 (2분 / 3분)
    ======================================================================= */
    function updateTimerUI() {
      const mins = Math.floor(state.timerRemaining / 60);
      const secs = state.timerRemaining % 60;
      els.timerDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

      const pct = Math.max(0, (state.timerRemaining / state.timerPresetSeconds) * 100);
      els.timerProgressBar.style.width = `${pct}%`;

      // 남은 시간에 따른 부드러운 색상 변화
      els.timerDisplay.classList.remove('text-sage-900', 'text-warm-600', 'text-rose-600');
      els.timerProgressBar.classList.remove('bg-sage-500', 'bg-warm-500', 'bg-rose-500');

      if (state.timerRemaining === 0) {
        els.timerDisplay.classList.add('text-rose-600');
        els.timerProgressBar.classList.add('bg-rose-500');
      } else if (state.timerRemaining <= 30) {
        els.timerDisplay.classList.add('text-warm-600');
        els.timerProgressBar.classList.add('bg-warm-500');
      } else {
        els.timerDisplay.classList.add('text-sage-900');
        els.timerProgressBar.classList.add('bg-sage-500');
      }

      els.btnTimerToggle.textContent = state.timerRunning ? '일시정지' : (state.timerRemaining === 0 ? '다시 시작' : '시작');
    }

    function pauseTimer() {
      if (state.timerInterval) {
        clearInterval(state.timerInterval);
        state.timerInterval = null;
      }
      state.timerRunning = false;
      updateTimerUI();
    }

    function startTimer() {
      if (state.timerRemaining <= 0) {
        state.timerRemaining = state.timerPresetSeconds;
      }
      if (state.timerRunning) return;
      state.timerRunning = true;
      updateTimerUI();

      state.timerInterval = setInterval(() => {
        if (state.timerRemaining > 0) {
          state.timerRemaining -= 1;
          updateTimerUI();
          if (state.timerRemaining === 0) {
            pauseTimer();
            playGentleChime();
            showToast('⏰ 발언 시간이 종료되었습니다! 따뜻한 박수로 마무리해 주세요.', 'warm');
          }
        }
      }, 1000);
    }

    function resetTimer(seconds = state.timerPresetSeconds) {
      pauseTimer();
      state.timerPresetSeconds = seconds;
      state.timerRemaining = seconds;
      updateTimerUI();
    }

    /* =======================================================================
       9. 랜덤 발언권 추첨 애니메이션
    ======================================================================= */
    async function runRandomDraw() {
      if (state.isDrawing) return;

      const waitingStories = state.stories.filter((s) => s.status === 'waiting');
      if (waitingStories.length === 0) {
        showToast('발언 대기 중인 사연이 없습니다. 새로운 사연을 기다리거나 완료된 사연을 되돌려주세요.', 'warm');
        return;
      }

      state.isDrawing = true;
      pauseTimer();

      // 추첨 중 UI 표시
      els.spotlightIdle.classList.add('hidden');
      els.spotlightActive.classList.add('hidden');
      els.spotlightDrawing.classList.remove('hidden');
      els.spotlightStage.scrollIntoView({ behavior: 'smooth', block: 'center' });

      // 부드러운 룰렛 애니메이션
      let ticks = 0;
      const maxTicks = waitingStories.length === 1 ? 6 : 16;

      const chosen = waitingStories[Math.floor(Math.random() * waitingStories.length)];

      const runTick = () => {
        const preview = waitingStories[ticks % waitingStories.length];
        els.drawRouletteNickname.textContent = preview.nickname;
        els.drawRouletteTitle.textContent = preview.title;
        ticks += 1;

        if (ticks < maxTicks) {
          const delay = 70 + ticks * 12; // 점점 느려지는 효과
          setTimeout(runTick, delay);
        } else {
          // 최종 선정 반영
          els.drawRouletteNickname.textContent = chosen.nickname;
          els.drawRouletteTitle.textContent = chosen.title;

          setTimeout(async () => {
            state.isDrawing = false;
            await grantFloorToStory(chosen.id);
            playGentleChime();
            showToast(`🎤 '${chosen.nickname}'님의 사연에 발언권이 부여되었습니다!`, 'warm');
          }, 350);
        }
      };

      runTick();
    }

    /* =======================================================================
       10. 대시보드 및 전체 뷰 렌더링
    ======================================================================= */
    function renderAllViews() {
      const total = state.stories.length;
      const waitingCount = state.stories.filter((s) => s.status === 'waiting').length;
      const completedCount = state.stories.filter((s) => s.status === 'completed').length;

      // 상단 카운트 & 모달 카운트 업데이트
      els.navCountBadge.textContent = total;
      els.statTotal.textContent = total;
      els.statWaiting.textContent = waitingCount;
      els.statCompleted.textContent = completedCount;
      els.modalStoryCount.textContent = total;

      renderSpotlight();
      renderStoryCards();
    }

    function renderSpotlight() {
      if (state.isDrawing) return;

      const activeStory = state.stories.find((s) => s.status === 'speaking');

      if (!activeStory) {
        if (state.activeSpeakerId !== null) {
          state.activeSpeakerId = null;
          pauseTimer();
        }
        els.spotlightIdle.classList.remove('hidden');
        els.spotlightDrawing.classList.add('hidden');
        els.spotlightActive.classList.add('hidden');
        els.spotlightStage.classList.remove('border-warm-400', 'shadow-spotlight', 'from-warm-50/80');
        els.spotlightStage.classList.add('border-sage-200/80', 'shadow-soft');
        return;
      }

      // 새 발언자로 바뀐 경우 타이머 초기화
      if (state.activeSpeakerId !== activeStory.id) {
        state.activeSpeakerId = activeStory.id;
        resetTimer(state.timerPresetSeconds);
      }

      els.spotlightIdle.classList.add('hidden');
      els.spotlightDrawing.classList.add('hidden');
      els.spotlightActive.classList.remove('hidden');

      els.spotlightStage.classList.remove('border-sage-200/80', 'shadow-soft');
      els.spotlightStage.classList.add('border-warm-400', 'shadow-spotlight', 'from-warm-50/80');

      els.spotNickname.textContent = activeStory.nickname;
      els.spotTime.textContent = formatTime(activeStory.createdAt);
      els.spotTitle.textContent = activeStory.title;
      els.spotContent.textContent = activeStory.content;
      els.spotEmpathyCount.textContent = activeStory.empathyCount || 0;
    }

    function renderStoryCards() {
      const q = state.searchQuery.trim().toLowerCase();

      const filtered = state.stories.filter((story) => {
        // 필터 조건
        if (state.filter === 'waiting' && story.status !== 'waiting') return false;
        if (state.filter === 'completed' && story.status !== 'completed') return false;

        // 검색 조건
        if (q) {
          const hay = `${story.nickname} ${story.title} ${story.content}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      els.filteredCountLabel.textContent = `${filtered.length}건`;

      if (filtered.length === 0) {
        els.storiesGrid.innerHTML = '';
        els.storiesEmpty.classList.remove('hidden');
        if (state.stories.length > 0) {
          els.emptyTitle.textContent = '조건에 맞는 사연이 없습니다';
          els.emptyDesc.textContent = '다른 필터를 선택하거나 검색어를 지워보세요.';
        } else {
          els.emptyTitle.textContent = '아직 등록된 사연이 없어요';
          els.emptyDesc.textContent = '상단의 ‘QR 크게 띄우기’로 참가자들을 초대하거나, 리허설용 ‘샘플 사연 추가’ 버튼을 눌러보세요.';
        }
        return;
      }

      els.storiesEmpty.classList.add('hidden');

      els.storiesGrid.innerHTML = filtered.map((story) => {
        const isSpeaking = story.status === 'speaking';
        const isCompleted = story.status === 'completed';

        // 카드 외형 스타일
        let cardStyle = 'bg-white border-sage-200/80 hover:border-sage-300 hover:shadow-soft';
        if (isSpeaking) {
          cardStyle = 'bg-warm-50/60 border-warm-400 ring-2 ring-warm-200 shadow-spotlight';
        } else if (isCompleted) {
          cardStyle = 'bg-cream-50/90 border-sage-200/60 opacity-80 hover:opacity-100';
        }

        // 상태 뱃지
        let statusBadge = '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-sage-50 text-sage-700 border border-sage-200">발언 대기</span>';
        if (isSpeaking) {
          statusBadge = '<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-warm-500 text-white"><span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>발언 중</span>';
        } else if (isCompleted) {
          statusBadge = '<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">✓ 발언 완료</span>';
        }

        // 우측 발언권 액션 버튼
        let floorActionBtn = `
          <button type="button" data-action="grant" data-id="${escapeHtml(story.id)}"
            class="px-3.5 py-2 rounded-xl bg-sage-600 hover:bg-sage-700 active:scale-95 text-white text-xs font-bold shadow-sm transition-all flex items-center gap-1">
            <span>🎤</span><span>발언권 부여</span>
          </button>`;

        if (isSpeaking) {
          floorActionBtn = `
            <button type="button" data-action="focus-stage" data-id="${escapeHtml(story.id)}"
              class="px-3.5 py-2 rounded-xl bg-warm-500 hover:bg-warm-600 text-white text-xs font-bold transition-all flex items-center gap-1">
              <span>✨</span><span>무대 보기</span>
            </button>`;
        } else if (isCompleted) {
          floorActionBtn = `
            <button type="button" data-action="revert" data-id="${escapeHtml(story.id)}"
              class="px-3 py-2 rounded-xl bg-white hover:bg-sage-50 text-sage-700 border border-sage-200 text-xs font-semibold transition-all">
              ↺ 대기로 되돌리기
            </button>`;
        }

        const initial = escapeHtml((story.nickname || '익').trim().charAt(0));

        return `
          <article class="rounded-3xl border p-5 sm:p-6 flex flex-col justify-between gap-4 transition-all duration-200 shadow-card ${cardStyle}">
            <div class="space-y-3.5">
              <!-- 카드 상단: 작성자 정보 & 상태 배지 -->
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-center gap-2.5 min-w-0">
                  <div class="w-9 h-9 rounded-full ${isSpeaking ? 'bg-warm-100 text-warm-600' : 'bg-sage-100 text-sage-700'} font-bold text-sm flex items-center justify-center shrink-0">
                    ${initial}
                  </div>
                  <div class="min-w-0">
                    <p class="text-sm font-bold text-sage-900 truncate">${escapeHtml(story.nickname)}</p>
                    <p class="text-[11px] text-sage-500">${formatTime(story.createdAt)}</p>
                  </div>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  ${statusBadge}
                  <button type="button" data-action="delete" data-id="${escapeHtml(story.id)}" title="사연 삭제"
                    class="w-7 h-7 rounded-lg text-sage-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition-colors text-xs">
                    ✕
                  </button>
                </div>
              </div>

              <!-- 제목 및 내용 -->
              <div class="space-y-2">
                <h4 class="text-base sm:text-lg font-bold text-sage-900 leading-snug break-words ${isCompleted ? 'line-through decoration-sage-400/70 text-sage-700' : ''}">
                  ${escapeHtml(story.title)}
                </h4>
                <p class="text-sm text-sage-700 leading-relaxed whitespace-pre-line break-words">
                  ${escapeHtml(story.content)}
                </p>
              </div>
            </div>

            <!-- 카드 하단: 공감 버튼 & 발언권 버튼 -->
            <div class="pt-3.5 border-t border-sage-100 flex items-center justify-between gap-2">
              <button type="button" data-action="empathy" data-id="${escapeHtml(story.id)}"
                class="empathy-btn px-3 py-2 rounded-xl bg-sage-50 hover:bg-sage-100 active:scale-95 border border-sage-200/80 text-sage-800 text-xs font-semibold transition-all flex items-center gap-1.5">
                <span>🌿</span>
                <span>공감해요</span>
                <span class="font-bold text-sage-700 tabular-nums">${story.empathyCount || 0}</span>
              </button>

              ${floorActionBtn}
            </div>
          </article>
        `;
      }).join('');
    }

    /* =======================================================================
       11. 이벤트 바인딩
    ======================================================================= */
    function bindEvents() {
      // 상단 탭 전환
      els.tabWrite.addEventListener('click', () => switchPage('write'));
      els.tabDashboard.addEventListener('click', () => switchPage('dashboard'));

      // 해시 변경 대응
      window.addEventListener('hashchange', checkInitialRoute);

      // QR 갱신 & 복사 & 모달 열기/닫기
      document.getElementById('btn-update-qr').addEventListener('click', () => {
        const val = els.qrUrlInput.value.trim();
        if (!val) {
          showToast('QR로 변환할 주소를 입력해 주세요.', 'error');
          return;
        }
        renderQrCodes(val);
        showToast('QR 코드가 새 주소로 갱신되었습니다! 📱');
      });

      els.qrUrlInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          document.getElementById('btn-update-qr').click();
        }
      });

      document.getElementById('btn-copy-link').addEventListener('click', () => {
        copyTextToClipboard(state.qrTargetUrl);
      });

      const openQrModal = () => {
        els.qrModal.classList.remove('hidden');
        els.qrModal.classList.add('flex');
      };
      const closeQrModal = () => {
        els.qrModal.classList.add('hidden');
        els.qrModal.classList.remove('flex');
      };

      document.getElementById('btn-open-qr-modal').addEventListener('click', openQrModal);
      document.getElementById('btn-dash-qr').addEventListener('click', openQrModal);
      document.getElementById('btn-close-qr-modal').addEventListener('click', closeQrModal);
      els.qrModal.addEventListener('click', (e) => {
        if (e.target === els.qrModal) closeQrModal();
      });

      // 참가자 모바일 모드 미리보기 & 빠져나오기
      document.getElementById('btn-preview-mobile').addEventListener('click', () => {
        setMobileWriteOnlyMode(true);
        window.scrollTo({ top: 0, behavior: 'smooth' });
        showToast('참가자가 QR 스캔 시 보게 되는 모바일 작성 화면입니다.');
      });

      document.getElementById('btn-exit-mobile-mode').addEventListener('click', () => {
        setMobileWriteOnlyMode(false);
        switchPage('dashboard');
      });

      // 랜덤 닉네임 생성
      document.getElementById('btn-random-nickname').addEventListener('click', () => {
        const current = els.inputNickname.value.trim();
        let next = RANDOM_NICKNAMES[Math.floor(Math.random() * RANDOM_NICKNAMES.length)];
        if (next === current) {
          next = RANDOM_NICKNAMES[(RANDOM_NICKNAMES.indexOf(next) + 1) % RANDOM_NICKNAMES.length];
        }
        els.inputNickname.value = next;
        els.inputNickname.focus();
      });

      // 글자 수 카운터
      els.inputContent.addEventListener('input', () => {
        els.charCount.textContent = `${els.inputContent.value.length} / 600자`;
      });

      // 사연 제출 폼 처리
      els.storyForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nickname = els.inputNickname.value.trim();
        const title = els.inputTitle.value.trim();
        const content = els.inputContent.value.trim();

        if (!nickname || !title || !content) {
          els.formErrorMsg.textContent = '닉네임, 제목(키워드), 내용을 모두 작성해 주세요.';
          els.formErrorMsg.classList.remove('hidden');
          return;
        }
        els.formErrorMsg.classList.add('hidden');

        els.btnSubmitStory.disabled = true;
        els.btnSubmitStory.innerHTML = '<span>🌿</span><span>전달하는 중...</span>';

        try {
          await createStory({ nickname, title, content });
          els.storyForm.reset();
          els.charCount.textContent = '0 / 600자';
          els.storyForm.classList.add('hidden');
          els.submitSuccessView.classList.remove('hidden');
          showToast('대나무숲에 안전하게 전달되었습니다 🎋');
        } catch (err) {
          console.error('사연 저장 오류:', err);
          els.formErrorMsg.textContent = '전송 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요.';
          els.formErrorMsg.classList.remove('hidden');
        } finally {
          els.btnSubmitStory.disabled = false;
          els.btnSubmitStory.innerHTML = '<span>🎋</span><span>대나무숲에 사연 남기기</span>';
        }
      });

      // 제출 완료 후 버튼들
      document.getElementById('btn-write-another').addEventListener('click', () => {
        els.submitSuccessView.classList.add('hidden');
        els.storyForm.classList.remove('hidden');
        els.inputNickname.focus();
      });

      document.getElementById('btn-go-dashboard-after-submit').addEventListener('click', () => {
        els.submitSuccessView.classList.add('hidden');
        els.storyForm.classList.remove('hidden');
        switchPage('dashboard');
      });

      // 대시보드 필터 버튼
      document.querySelectorAll('.filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.filter = btn.dataset.filter;
          document.querySelectorAll('.filter-btn').forEach((b) => {
            b.className = 'filter-btn px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-sage-600 hover:text-sage-900 transition-all';
          });
          btn.className = 'filter-btn px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-white text-sage-900 shadow-sm transition-all';
          renderStoryCards();
        });
      });

      // 키워드 검색
      els.searchInput.addEventListener('input', (e) => {
        state.searchQuery = e.target.value;
        renderStoryCards();
      });

      // 리허설용 샘플 사연 추가
      document.getElementById('btn-add-sample').addEventListener('click', async () => {
        const sample = SAMPLE_STORIES[state.sampleIndex % SAMPLE_STORIES.length];
        state.sampleIndex += 1;
        try {
          await createStory(sample);
          showToast(`샘플 사연 '${sample.nickname}'이(가) 추가되었습니다 ✨`);
        } catch (err) {
          showToast('샘플 추가 중 오류가 발생했습니다.', 'error');
        }
      });

      // 데이터 초기화 (커스텀 확인 모달 사용)
      document.getElementById('btn-reset-data').addEventListener('click', () => {
        if (state.stories.length === 0) {
          showToast('초기화할 사연이 없습니다.', 'warm');
          return;
        }
        openConfirmModal({
          icon: '🗑️',
          title: '모든 사연을 초기화할까요?',
          desc: `현재 등록된 ${state.stories.length}건의 사연이 모두 삭제됩니다. 워크샵 본 세션 시작 전 리허설 데이터를 비울 때 사용해 주세요.`,
          okText: '모두 삭제',
          okStyle: 'danger',
          onConfirm: async () => {
            pauseTimer();
            await clearAllStories();
            showToast('모든 사연이 깔끔하게 초기화되었습니다.');
          }
        });
      });

      // 확인 모달 버튼
      els.btnConfirmCancel.addEventListener('click', closeConfirmModal);
      els.btnConfirmOk.addEventListener('click', async () => {
        const cb = state.confirmCallback;
        closeConfirmModal();
        if (cb) await cb();
      });
      els.confirmModal.addEventListener('click', (e) => {
        if (e.target === els.confirmModal) closeConfirmModal();
      });

      // 스포트라이트 랜덤 추첨
      document.getElementById('btn-random-draw').addEventListener('click', runRandomDraw);

      // 스포트라이트 타이머 프리셋 (2분/3분)
      document.querySelectorAll('.timer-preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mins = parseInt(btn.dataset.minutes, 10);
          document.querySelectorAll('.timer-preset-btn').forEach((b) => {
            b.className = 'timer-preset-btn px-2.5 py-1 rounded-lg text-xs font-bold text-sage-600 hover:text-sage-900 transition-all';
          });
          btn.className = 'timer-preset-btn px-2.5 py-1 rounded-lg text-xs font-bold bg-white text-sage-900 shadow-sm transition-all';
          resetTimer(mins * 60);
        });
      });

      els.btnTimerToggle.addEventListener('click', () => {
        if (state.timerRunning) pauseTimer();
        else startTimer();
      });

      els.btnTimerReset.addEventListener('click', () => {
        resetTimer(state.timerPresetSeconds);
      });

      // 스포트라이트 공감 / 대기로 내리기 / 발언 완료 / 완료 후 다음 랜덤 추첨
      document.getElementById('btn-spot-empathy').addEventListener('click', async (e) => {
        if (!state.activeSpeakerId) return;
        e.currentTarget.classList.add('animate-pop');
        setTimeout(() => e.currentTarget.classList.remove('animate-pop'), 300);
        await incrementStoryEmpathy(state.activeSpeakerId);
      });

      document.getElementById('btn-spot-return-wait').addEventListener('click', async () => {
        if (!state.activeSpeakerId) return;
        pauseTimer();
        await updateStoryFields(state.activeSpeakerId, { status: 'waiting' });
        showToast('사연을 다시 발언 대기 상태로 내렸습니다.');
      });

      document.getElementById('btn-spot-complete').addEventListener('click', async () => {
        if (!state.activeSpeakerId) return;
        pauseTimer();
        await updateStoryFields(state.activeSpeakerId, { status: 'completed' });
        showToast('✅ 발언이 완료 처리되었습니다! 따뜻한 나눔 감사해요.');
      });

      document.getElementById('btn-spot-next-random').addEventListener('click', async () => {
        if (!state.activeSpeakerId) return;
        const currentId = state.activeSpeakerId;
        pauseTimer();
        await updateStoryFields(currentId, { status: 'completed' });

        // 완료 반영 후 남은 대기 사연이 있으면 바로 다음 추첨 실행
        setTimeout(() => {
          const remaining = state.stories.filter((s) => s.status === 'waiting');
          if (remaining.length > 0) {
            runRandomDraw();
          } else {
            showToast('🎉 모든 대기 사연의 발언이 완료되었습니다!', 'warm');
          }
        }, 200);
      });

      // 사연 카드 보드 이벤트 위임
      els.storiesGrid.addEventListener('click', async (e) => {
        const btn = e.target.closest('button[data-action]');
        if (!btn) return;
        const action = btn.dataset.action;
        const id = btn.dataset.id;

        if (action === 'empathy') {
          btn.classList.add('animate-pop');
          setTimeout(() => btn.classList.remove('animate-pop'), 300);
          await incrementStoryEmpathy(id);
        } else if (action === 'grant') {
          await grantFloorToStory(id);
          const target = state.stories.find((s) => s.id === id);
          if (target) {
            showToast(`🎤 '${target.nickname}'님에게 발언권을 부여했습니다!`, 'warm');
          }
        } else if (action === 'focus-stage') {
          els.spotlightStage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else if (action === 'revert') {
          await updateStoryFields(id, { status: 'waiting' });
          showToast('사연을 다시 발언 대기 상태로 되돌렸습니다.');
        } else if (action === 'delete') {
          const target = state.stories.find((s) => s.id === id);
          openConfirmModal({
            icon: '🌿',
            title: '이 사연을 삭제할까요?',
            desc: target ? `'${target.nickname}'님의 사연을 목록에서 삭제합니다.` : '선택한 사연을 삭제합니다.',
            okText: '삭제',
            okStyle: 'danger',
            onConfirm: async () => {
              await deleteSingleStory(id);
              showToast('사연이 삭제되었습니다.');
            }
          });
        }
      });

      // ESC 키로 모달 닫기
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeQrModal();
          closeConfirmModal();
        }
      });
    }

    /* =======================================================================
       12. 앱 초기화
    ======================================================================= */
    async function initApp() {
      bindEvents();
      checkInitialRoute();
      const initialUrl = detectInitialQrUrl();
      renderQrCodes(initialUrl);
      updateTimerUI();
      await initStorageAndSync();
    }

    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
