    async function initStorageAndSync() {
      // 1) 환경에 Firebase 설정이 주입된 경우 Firestore 실시간 동기화 시도
      const hasFirebaseConfig = typeof __firebase_config !== 'undefined' && __firebase_config;

      if (hasFirebaseConfig) {
        try {
          const firebaseConfig = typeof __firebase_config === 'string'
            ? JSON.parse(__firebase_config)
            : __firebase_config;

          state.appId = typeof __app_id !== 'undefined' && __app_id ? __app_id : 'default-app-id';
          const app = initializeApp(firebaseConfig);
          state.auth = getAuth(app);
          state.db = getFirestore(app);

          // RULE 3: 인증 완료를 반드시 먼저 대기 (Custom Token 우선 -> 익명 로그인 폴백)
          if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            await signInWithCustomToken(state.auth, __initial_auth_token);
          } else {
            await signInAnonymously(state.auth);
          }

          state.currentUser = state.auth.currentUser;
          if (!state.currentUser) {
            throw new Error('Firebase 인증 사용자 정보를 가져오지 못했습니다.');
          }

          state.storageMode = 'firebase';
          updateSyncBadgeUI('클라우드 실시간 동기화');

          // RULE 1 & RULE 2: 단순 collection 쿼리 + 메모리 내 정렬 + 에러 콜백 필수
          const colRef = getPublicCollectionRef();
          state.unsubscribeSnapshot = onSnapshot(
            colRef,
            (snapshot) => {
              const loaded = [];
              snapshot.forEach((docSnap) => {
                const data = docSnap.data();
                loaded.push({
                  id: docSnap.id,
                  nickname: data.nickname || '익명 대나무',
                  title: data.title || '',
                  content: data.content || '',
                  createdAt: typeof data.createdAt === 'number' ? data.createdAt : Date.now(),
                  status: data.status || 'waiting',
                  empathyCount: typeof data.empathyCount === 'number' ? data.empathyCount : 0
                });
              });
              // 최신순 정렬 (메모리 내 처리)
              loaded.sort((a, b) => b.createdAt - a.createdAt);
              state.stories = loaded;
              renderAllViews();
            },
            (error) => {
              console.warn('Firestore onSnapshot 오류, 로컬 폴백으로 전환합니다:', error);
              activateLocalFallback();
            }
          );

          return;
        } catch (err) {
          console.warn('Firebase 초기화 실패, 로컬 모드로 자동 폴백합니다:', err);
        }
      }

      // 2) 로컬 PC 단독 HTML 실행 환경 등 Firebase 미지원 시 자동 폴백
      activateLocalFallback();
    }

    function activateLocalFallback() {
      state.storageMode = 'local';
      updateSyncBadgeUI('로컬 브라우저 실시간 동기화');

      // 초기 데이터 로드
      state.stories = readLocalStories();
      renderAllViews();

      // BroadcastChannel로 동일 브라우저 내 탭 간 실시간 동기화
      try {
        if ('BroadcastChannel' in window) {
          state.broadcastChannel = new BroadcastChannel(BROADCAST_CHANNEL_NAME);
          state.broadcastChannel.onmessage = (event) => {
            if (event.data && event.data.type === 'SYNC_STORIES') {
              state.stories = readLocalStories();
              renderAllViews();
            }
          };
        }
      } catch (e) {
        // file:// 일부 구형 환경에서는 BroadcastChannel이 제한될 수 있으므로 storage 이벤트와 병행
      }

      // storage 이벤트 리스너로 다른 탭에서 변경 시 자동 갱신
      window.addEventListener('storage', (e) => {
        if (e.key === LOCAL_STORAGE_KEY) {
          state.stories = readLocalStories();
          renderAllViews();
        }
      });
    }

    function readLocalStories() {
      try {
        const raw = window.localStorage.getItem(LOCAL_STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        return parsed.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
      } catch (e) {
        return state.stories || [];
      }
    }

    function saveLocalStories(stories) {
      const sorted = [...stories].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
      state.stories = sorted;
      try {
        window.localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(sorted));
      } catch (e) {
        console.warn('로컬 저장소 쓰기 제한:', e);
      }
      try {
        if (state.broadcastChannel) {
          state.broadcastChannel.postMessage({ type: 'SYNC_STORIES', timestamp: Date.now() });
        }
      } catch (e) {
        // 무시
      }
      renderAllViews();
    }

    function updateSyncBadgeUI(text) {
      els.syncModeBadge.textContent = text;
    }

    /* ----- CRUD 메서드 (Firebase / Local 통합 인터페이스) ----- */
    async function createStory({ nickname, title, content }) {
      const payload = {
        nickname: nickname.trim(),
        title: title.trim(),
        content: content.trim(),
        createdAt: Date.now(),
        status: 'waiting',
        empathyCount: 0
      };

      if (state.storageMode === 'firebase') {
        if (!state.currentUser) return;
        await addDoc(getPublicCollectionRef(), payload);
      } else {
        const newStory = {
          id: 'local_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          ...payload
        };
        saveLocalStories([newStory, ...state.stories]);
      }
    }

    async function updateStoryFields(storyId, fields) {
      if (state.storageMode === 'firebase') {
        if (!state.currentUser) return;
        await updateDoc(getPublicDocRef(storyId), fields);
      } else {
        const updated = state.stories.map((s) => (s.id === storyId ? { ...s, ...fields } : s));
        saveLocalStories(updated);
      }
    }

    async function incrementStoryEmpathy(storyId) {
      if (state.storageMode === 'firebase') {
        if (!state.currentUser) return;
        await updateDoc(getPublicDocRef(storyId), { empathyCount: increment(1) });
      } else {
        const updated = state.stories.map((s) =>
          s.id === storyId ? { ...s, empathyCount: (s.empathyCount || 0) + 1 } : s
        );
        saveLocalStories(updated);
      }
    }

    async function deleteSingleStory(storyId) {
      if (state.storageMode === 'firebase') {
        if (!state.currentUser) return;
        await deleteDoc(getPublicDocRef(storyId));
      } else {
        const updated = state.stories.filter((s) => s.id !== storyId);
        saveLocalStories(updated);
      }
    }

    async function clearAllStories() {
      if (state.storageMode === 'firebase') {
        if (!state.currentUser) return;
        const deletions = state.stories.map((s) => deleteDoc(getPublicDocRef(s.id)));
        await Promise.all(deletions);
      } else {
        saveLocalStories([]);
      }
    }

    // 특정 사연에 발언권 부여 (기존 발언 중인 사연이 있으면 자동으로 '발언 대기'로 전환)
    async function grantFloorToStory(storyId) {
      const prevSpeakers = state.stories.filter((s) => s.status === 'speaking' && s.id !== storyId);

      if (state.storageMode === 'firebase') {
        if (!state.currentUser) return;
        const ops = prevSpeakers.map((s) => updateDoc(getPublicDocRef(s.id), { status: 'waiting' }));
        ops.push(updateDoc(getPublicDocRef(storyId), { status: 'speaking' }));
        await Promise.all(ops);
      } else {
        const updated = state.stories.map((s) => {
          if (s.id === storyId) return { ...s, status: 'speaking' };
          if (s.status === 'speaking') return { ...s, status: 'waiting' };
          return s;
        });
        saveLocalStories(updated);
      }

      // 새 발언자 등장 시 타이머 리셋
      resetTimer(state.timerPresetSeconds);
      // 대시보드 상단 스포트라이트로 부드럽게 스크롤
      els.spotlightStage.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    /* =======================================================================
       6. QR 코드 생성 및 URL 관리
    ======================================================================= */
    function detectInitialQrUrl() {
      const href = window.location.href;
      const protocol = window.location.protocol;

      if (protocol === 'http:' || protocol === 'https:') {
        try {
          const urlObj = new URL(href);
          urlObj.searchParams.set('mode', 'write');
          urlObj.hash = '';
          els.localUrlNotice.classList.add('hidden');
          return urlObj.toString();
        } catch (e) {
          // fallback below
        }
      }

      // 로컬 파일(file://) 또는 iframe 미리보기(about:srcdoc / blob:) 환경 안내
      els.localUrlNotice.classList.remove('hidden');
      if (protocol === 'file:') {
        return href.split('?')[0].split('#')[0] + '?mode=write';
      }
      return 'https://workshop-bamboo-forest.example.com/?mode=write';
    }

    function renderQrCodes(url) {
      const safeUrl = (url || '').trim();
      if (!safeUrl) return;
      state.qrTargetUrl = safeUrl;

      els.qrUrlInput.value = safeUrl;
      els.qrUrlPreview.textContent = safeUrl;
      els.modalQrUrl.textContent = safeUrl;

      // 1페이지 카드용 QR 생성
      els.qrContainer.innerHTML = '';
      try {
        new QRCode(els.qrContainer, {
          text: safeUrl,
          width: 180,
          height: 180,
          colorDark: '#233B2A',
          colorLight: '#FFFFFF',
          correctLevel: QRCode.CorrectLevel.M
        });
      } catch (err) {
        els.qrContainer.innerHTML = '<p class="text-xs text-rose-500 p-4">주소가 너무 길어 QR을 생성할 수 없습니다. 짧은 주소를 입력해 주세요.</p>';
      }

      // 대형 모달용 QR 생성
      els.modalQrContainer.innerHTML = '';
      try {
        new QRCode(els.modalQrContainer, {
          text: safeUrl,
          width: 256,
          height: 256,
          colorDark: '#233B2A',
          colorLight: '#FFFFFF',
          correctLevel: QRCode.CorrectLevel.M
        });
      } catch (err) {
        els.modalQrContainer.innerHTML = '<p class="text-xs text-rose-500 p-4">QR 생성 오류</p>';
      }
    }

    /* =======================================================================
       7. 네비게이션 및 모바일 전용 작성 모드(?mode=write) 전환
